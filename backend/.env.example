# --- Base de datos (Neon) ---
# Pooled connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/agropay?sslmode=require"
# Direct connection (no "-pooler"), used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/agropay?sslmode=require"

# --- Admin único ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

# --- Server ---
PORT=3001
# Only needed if the frontend is served from a different origin (comma-separated)
CORS_ORIGIN="http://localhost:5173"
